{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "tf-diff",
          "version": "0.4.0",
          "semanticVersion": "0.4.0",
          "rules": [
            {
              "id": "backup-disabled",
              "name": "backup-disabled",
              "shortDescription": {
                "text": "Backup retention, final snapshot or point-in-time recovery is turned off"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "destroy-production-resource",
              "name": "destroy-production-resource",
              "shortDescription": {
                "text": "Resource deleted in production"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "encryption-disabled",
              "name": "encryption-disabled",
              "shortDescription": {
                "text": "Encryption flag goes from true to false"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "public-database",
              "name": "public-database",
              "shortDescription": {
                "text": "RDS instance becomes publicly accessible"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "reduce-capacity",
              "name": "reduce-capacity",
              "shortDescription": {
                "text": "Capacity attribute drops by the threshold percent or more"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "remove-redundancy",
              "name": "remove-redundancy",
              "shortDescription": {
                "text": "Zone or subnet spread falls to one, or Multi-AZ is turned off"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "replace-resource",
              "name": "replace-resource",
              "shortDescription": {
                "text": "Resource is destroyed and recreated (medium in production, low elsewhere)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "stateful-data-loss",
              "name": "stateful-data-loss",
              "shortDescription": {
                "text": "Data store is deleted or replaced: critical in production, high elsewhere; one step lower when a final snapshot or deletion guard keeps the data"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "s3-public-access-weakened",
              "name": "s3-public-access-weakened",
              "shortDescription": {
                "text": "S3 public access block is turned off or deleted"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "security-group-wide-open",
              "name": "security-group-wide-open",
              "shortDescription": {
                "text": "Security group ingress newly open to 0.0.0.0/0 or ::/0 (critical on admin/database ports)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "sensitive-value-changed",
              "name": "sensitive-value-changed",
              "shortDescription": {
                "text": "Sensitive attribute changes (the value is never shown)"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "security-severity": "1.0",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "wide-blast-radius",
              "name": "wide-blast-radius",
              "shortDescription": {
                "text": "Destroyed or replaced resource has many dependents"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            }
          ]
        }
      },
