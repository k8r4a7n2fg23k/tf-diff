{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "tf-diff",
          "version": "0.2.0",
          "semanticVersion": "0.2.0",
          "rules": [
            {
              "id": "backup-disabled",
              "name": "backup-disabled",
              "shortDescription": {
                "text": "Backup retention, final snapshot or point-in-time recovery is turned off"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "destroy-production-resource",
              "name": "destroy-production-resource",
              "shortDescription": {
                "text": "Resource deleted in production"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "encryption-disabled",
              "name": "encryption-disabled",
              "shortDescription": {
                "text": "Encryption flag goes from true to false"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "public-database",
              "name": "public-database",
              "shortDescription": {
                "text": "RDS instance becomes publicly accessible"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "reduce-capacity",
              "name": "reduce-capacity",
              "shortDescription": {
                "text": "Capacity attribute drops by the threshold percent or more"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "remove-redundancy",
              "name": "remove-redundancy",
              "shortDescription": {
                "text": "Zone or subnet spread falls to one, or Multi-AZ is turned off"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "replace-resource",
              "name": "replace-resource",
              "shortDescription": {
                "text": "Resource is destroyed and recreated (medium in production, low elsewhere)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "stateful-data-loss",
              "name": "stateful-data-loss",
              "shortDescription": {
                "text": "Data store is deleted or replaced: critical in production, high elsewhere; one step lower when a final snapshot or deletion guard keeps the data"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "s3-public-access-weakened",
              "name": "s3-public-access-weakened",
              "shortDescription": {
                "text": "S3 public access block is turned off or deleted"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "security-group-wide-open",
              "name": "security-group-wide-open",
              "shortDescription": {
                "text": "Security group ingress newly open to 0.0.0.0/0 or ::/0 (critical on admin/database ports)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "sensitive-value-changed",
              "name": "sensitive-value-changed",
              "shortDescription": {
                "text": "Sensitive attribute changes (the value is never shown)"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "security-severity": "1.0",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            },
            {
              "id": "wide-blast-radius",
              "name": "wide-blast-radius",
              "shortDescription": {
                "text": "Destroyed or replaced resource has many dependents"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "terraform",
                  "infrastructure"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "wide-blast-radius",
          "ruleIndex": 11,
          "level": "warning",
          "message": {
            "text": "terraform_data.nic[\"a\"]: Wide blast radius. 5 resources depend on it (threshold 5)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "plan.json"
                },
                "region": {
                  "startLine": 1
                }
              },
              "logicalLocations": [
                {
                  "fullyQualifiedName": "terraform_data.nic[\"a\"]",
                  "kind": "resource"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "tfdiffFinding/v1": "08513b30c815958b567636f119383a9d67fbdf93b4083ee454b99a671f101200"
          },
          "properties": {
            "severity": "medium",
            "confidence": "high",
            "evidence": [
              "action: REPLACE (delete, create)",
              "environment: not set",
              "dependents: 5 direct, 0 indirect",
              "affected: terraform_data.after, terraform_data.all, terraform_data.vm[\"a\"], terraform_data.vm[\"b\"], terraform_data.vm[\"c\"]"
            ]
          }
        },
        {
          "ruleId": "replace-resource",
          "ruleIndex": 6,
          "level": "note",
          "message": {
            "text": "terraform_data.disk[0]: Resource replaced. Terraform plans replacement (replace_by_request)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "plan.json"
                },
                "region": {
                  "startLine": 1
                }
              },
              "logicalLocations": [
                {
                  "fullyQualifiedName": "terraform_data.disk[0]",
                  "kind": "resource"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "tfdiffFinding/v1": "c9ce1e390f645cb7e2f11bcfa4b12b37b495c68d57b421909bed91d9558a1f82"
          },
          "properties": {
            "severity": "low",
            "confidence": "high",
            "evidence": [
              "action: REPLACE (delete, create)",
              "environment: not set",
              "dependents: 3 direct, 0 indirect",
              "order: destroy before create: unavailable until the new one is up"
            ]
          }
        },
        {
          "ruleId": "replace-resource",
          "ruleIndex": 6,
          "level": "note",
          "message": {
            "text": "terraform_data.nic[\"a\"]: Resource replaced. triggers_replace cannot be updated in place"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "plan.json"
                },
                "region": {
                  "startLine": 1
                }
              },
              "logicalLocations": [
                {
                  "fullyQualifiedName": "terraform_data.nic[\"a\"]",
                  "kind": "resource"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "tfdiffFinding/v1": "a8790b5fe65b20f33ae7ad351494e0a5837f425572ce20f87a0beb2f5c584b95"
          },
          "properties": {
            "severity": "low",
            "confidence": "high",
            "evidence": [
              "action: REPLACE (delete, create)",
              "environment: not set",
              "dependents: 5 direct, 0 indirect",
              "order: destroy before create: unavailable until the new one is up",
              "triggers_replace[0]: 1 -> 2"
            ]
          }
        }
      ]
    }
  ]
}
