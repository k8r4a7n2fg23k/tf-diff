          "partialFingerprints": {
            "tfdiffFinding/v1": "f2fe2bec8ebab9af731eec403d2caa311d2e682641b4766778eb34f79d216a73"
          },
          "properties": {
            "severity": "info",
            "confidence": "high",
            "evidence": [
